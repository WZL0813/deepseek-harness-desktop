{
  "name": "dsh-desktop",
  "version": "1.0.1",
  "description": "DeepSeek Harness 桌面版 - 自包含 exe",
  "main": "main.js",
  "author": "dsh",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.dsh.desktop",
    "productName": "DeepSeek Harness",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "fallback.html",
      "icon.ico"
    ],
    "win": {
      "target": [
        { "target": "portable", "arch": ["x64"] }
      ],
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "DeepSeek-Harness.exe"
    }
  }
}
